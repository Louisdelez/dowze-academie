{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Accès Tauri réservé à la webview locale principale.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "main-commands",
    "updater:default",
    "process:allow-restart"
  ]
}
