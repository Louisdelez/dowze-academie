        "PKG_RELEASE": "1",
        "DYNPKG_RELEASE": "1",
        "NJS_VERSION": "1.0.1",
        "NJS_RELEASE": "1",
        "ACME_VERSION": "0.4.1",
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "restart": "unless-stopped",
      "labels": {
