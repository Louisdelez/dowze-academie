        "DOWZE_SYNC_MAX_DOCUMENT_BYTES": "4194304",
        "DOWZE_SYNC_ACCOUNT_QUOTA_BYTES": "2147483648",
        "DOWZE_BLOB_DIR": "/srv/dowze/data/blobs",
        "LANG": "C.UTF-8",
        "PYTHON_SHA256": "c08bc65a81971c1dd5783182826503369466c7e67374d1646519adf05207b684"
      },
      "restart": "unless-stopped",
      "labels": {
        "org.dowze.api.version": "0.4.1",
        "org.dowze.application.version": "0.4.0",
        "org.dowze.database": "supabase-postgresql",
        "org.dowze.migration": "nas-to-dowze01-20261006",
        "org.dowze.release": "0.2.0-v2",
        "org.dowze.stage11.cutover": "6e8f8d93-8cea-4960-8d1a-20426edec4a7"
      },
      "entrypoint": [
        "python3",
        "-I",
        "-B",
        "-m",
        "uvicorn"
      ],
      "command": [
        "app.notebook_startup:create_managed_app",
        "--factory",
        "--app-dir",
        "/srv/dowze/app",
        "--host",
        "0.0.0.0",
        "--port",
        "30582",
        "--workers",
        "1",
        "--no-access-log"
      ],
      "user": "10001:10001",
      "working_dir": "/srv/dowze/app",
      "hostname": "63e2e95eb4bd",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges",
        "label=level:s0:c102,c369"
      ],
      "shm_size": 67108864,
      "pids_limit": 64,
      "mem_limit": 805306368,
      "cpus": 1.0,
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=16m"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "5",
          "max-size": "20m"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "python -c \"import urllib.request;urllib.request.urlopen('http://127.0.0.1:30582/health',timeout=2).read()\""
        ],
        "interval": "30000000000ns",
        "timeout": "3000000000ns",
        "start_period": "10000000000ns",
        "retries": 3
      },
      "volumes": [
        "/srv/epicube/dowze/academie/config/secrets/postgres-url:/run/dowze-postgres-url:ro,z",
        "/srv/epicube/dowze/academie/backups:/srv/dowze/backups:rw,z",
        "/srv/epicube/dowze/academie/data:/srv/dowze/data:rw,z"
      ],
      "ports": [
        {
          "target": 30582,
          "published": "30582",
          "host_ip": "127.0.0.1",
          "protocol": "tcp"
        }
      ],
      "network_mode": "supabase_default"
    },
    "public": {
      "image": "sha256:ef8676b33d681f272ba429b27658bdd7e640963279714c96bddf1dc76307f7b6",
      "pull_policy": "never",
      "container_name": "dw-dowze-academie-public",
      "environment": {
