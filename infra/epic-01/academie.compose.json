{
  "name": "dw-native-academie",
  "services": {
    "api": {
      "image": "sha256:e66a61e69ab54881542de9a0582e5f678ce59a7de927ab4c603fa1a2943bf9ac",
      "pull_policy": "never",
      "container_name": "dw-dowze-academie-api",
      "environment": {
        "DOWZE_ALLOWED_ORIGINS": "https://academie.dowze.ch,https://academie.delez.ovh",
        "PATH": "/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "GPG_KEY": "7169605F62C751356D054A26A821E680E5FA6305",
        "PYTHON_VERSION": "3.12.13",
        "DOWZE_SYNC_REQUEST_LIMIT_PER_MINUTE": "1200",
        "DOWZE_REQUEST_LIMIT_PER_MINUTE": "240",
        "DOWZE_ENV": "production",
        "PYTHONDONTWRITEBYTECODE": "1",
        "DOWZE_DATABASE_SCHEMA": "dowze_academie",
