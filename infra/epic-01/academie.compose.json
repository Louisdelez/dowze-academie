        "org.dowze.migration": "nas-to-dowze01-20261006",
        "org.dowze.release": "dowze-public-020-v2"
      },
      "entrypoint": [
        "nginx"
      ],
      "command": [
        "-g",
        "daemon off;"
      ],
      "user": "101:101",
      "working_dir": "/",
      "hostname": "dowze-01",
      "stop_signal": "SIGQUIT",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges"
      ],
      "shm_size": 67108864,
      "pids_limit": 64,
      "mem_limit": 134217728,
      "cpus": 0.5,
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,size=48m,mode=1777"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "5",
          "max-size": "20m"
        }
      },
      "volumes": [
        "/srv/epicube/dowze/academie/public:/public:ro,z",
        "/srv/epicube/migrations/dowze-20261104/native/academie-nginx.conf:/etc/nginx/nginx.conf:ro,z"
      ],
      "network_mode": "host"
    }
  },
  "networks": {
    "dw-native-supabase": {
      "name": "dw-native-supabase",
      "external": true
    }
  }
