# Développement uniquement : ne remplace pas la factory scellée de production.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DOWZE_ENV=development
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
RUN groupadd --gid 10001 dowze && useradd --uid 10001 --gid 10001 --no-create-home dowze && mkdir -p data packages && chown 10001:10001 data packages
COPY app ./app
USER 10001:10001
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
