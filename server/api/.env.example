# Valeurs locales de développement uniquement ; aucune valeur de production.
DOWZE_ENV=development
DOWZE_DATABASE_PATH=data/api.sqlite3
DOWZE_PACKAGE_DIR=packages
DOWZE_BLOB_DIR=data/blobs
DOWZE_ALLOWED_ORIGINS=http://127.0.0.1:4173
# En PostgreSQL, renseigner un fichier privé externe :
# DOWZE_DATABASE_URL_FILE=/run/secrets/dowze_database_url
DOWZE_DATABASE_SCHEMA=dowze_academie
